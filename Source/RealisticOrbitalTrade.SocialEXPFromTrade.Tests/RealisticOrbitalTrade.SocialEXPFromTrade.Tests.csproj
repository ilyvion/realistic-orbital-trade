<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <UseLaboratory>true</UseLaboratory>
        <RootNamespace>RealisticOrbitalTrade.SocialEXPFromTrade.Tests</RootNamespace>
        <AssemblyName>RealisticOrbitalTrade.SocialEXPFromTrade.Tests</AssemblyName>
        <OutputPath>../../Integrations/SocialEXPFromTrade/$(RimWorldVersion)/Assemblies</OutputPath>
    </PropertyGroup>
    <!--
        Without the DevTools reference (see below), this project has no Publicize items of
        its own, so Krafs.Publicizer's generated IgnoresAccessChecksToAttribute merely shadows
        the one already made public inside the referenced RealisticOrbitalTrade.SocialEXPFromTrade
        assembly; CS0436 is harmless here.
    -->
    <PropertyGroup Condition="'$(RimWorldVersion)' != '1.6'">
        <NoWarn>$(NoWarn);CS0436</NoWarn>
    </PropertyGroup>
    <!--
        Dev-only test assembly for the Social Experience from Trade integration, built and run
        in-game via DevTools (https://github.com/ilyvion/SmashPhil-DevTools.git). Its output is
        deployed alongside RealisticOrbitalTrade.SocialEXPFromTrade.dll into
        Integrations/SocialEXPFromTrade/<version>/Assemblies, which LoadFolders.xml only loads
        when Social Experience from Trade (krelinos.socialexpfromtrade) is active, so these tests
        are only discovered when there's a Social Experience from Trade install for them to
        actually exercise, and launching RealisticOrbitalTrade without it never touches this
        assembly.

        It's listed in RealisticOrbitalTrade.sln so it always builds locally (default
        Configuration is Debug, see .vscode/build_config.sh), but RealisticOrbitalTrade.sln
        deliberately omits a Release|Any CPU.Build.0 line for this project's GUID, so a
        Release-configuration build (what CI/release always use, per rimworld-utils'
        build_mod.yml) skips building it entirely; its output never lands in a shipped release.

        DevTools only supports RimWorld 1.6, so for any other RimWorldVersion this project builds
        as an empty assembly: both the test sources and the DevTools reference are excluded
        below. DevTools' own OutDir is relative to its clone location, so it's redirected to this
        mod's 1.6/Assemblies folder, where DevTools.dll must sit to be loaded.
    -->
    <ItemGroup>
        <ProjectReference Include="..\RealisticOrbitalTrade\RealisticOrbitalTrade.csproj">
            <CopyLocal>False</CopyLocal>
            <Private>false</Private>
        </ProjectReference>
        <ProjectReference Include="..\RealisticOrbitalTrade.SocialEXPFromTrade\RealisticOrbitalTrade.SocialEXPFromTrade.csproj">
            <CopyLocal>False</CopyLocal>
            <Private>false</Private>
        </ProjectReference>
    </ItemGroup>
    <ItemGroup Condition="'$(RimWorldVersion)' == '1.6'">
        <ProjectReference
            Include="$(ProjectDependenciesBasePath)\Third-Party\DevTools\DevTools\DevTools.csproj"
            AdditionalProperties="OutDir=$(MSBuildThisFileDirectory)..\..\1.6\Assemblies\"
        >
            <CopyLocal>False</CopyLocal>
            <Private>false</Private>
        </ProjectReference>
    </ItemGroup>
    <ItemGroup Condition="'$(RimWorldVersion)' != '1.6'">
        <Compile Remove="**/*.cs" />
    </ItemGroup>
</Project>
